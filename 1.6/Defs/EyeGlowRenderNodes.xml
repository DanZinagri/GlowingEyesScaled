<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- Tags let the driver find its own nodes again through the public
       PawnRenderTree.TryGetNodeByTag, rather than keeping a Pawn-keyed dictionary
       that would have to be swept. -->
  <PawnRenderNodeTagDef>
    <defName>GES_EyeGlowLeft</defName>
  </PawnRenderNodeTagDef>

  <PawnRenderNodeTagDef>
    <defName>GES_EyeGlowRight</defName>
  </PawnRenderNodeTagDef>

  <!-- Mirrors the eye nodes Glowing eyes genes already ships on its gene defs:
       same anchorTag, same side, same -0.25 drop off the eye wound anchor. That
       drop puts the glow at head-local z -0.07, exactly the height its mote's
       hardcoded 0.27 implied (0.34 - 0.07), so the glow lands where it always did
       on a baseline pawn and only its behaviour under scaling changes.

       Deliberately NOT PawnRenderNodeProperties_Eye: that subclass sets skipFlag
       Eyes in ResolveReferences, and Facial Animation drops any gene-owned node of
       that class when its eye parts setting is off. These are injected without a
       gene attached, which dodges that filter entirely.

       Layer 72 sits just above head apparel (70), matching the mote it replaces,
       which drew at MoteOverhead and so shone through helmets. Drop it to 54 to
       have headgear cover the glow instead. Vanilla head layers for reference:
       beard 60, hair 62, wounds 65, head apparel 70, firefoam 85, status 100. -->
  <GlowingEyesScaled.EyeGlowDef>
    <defName>GES_EyeGlow</defName>
    <nodes>

      <li>
        <nodeClass>GlowingEyesScaled.PawnRenderNode_EyeGlow</nodeClass>
        <workerClass>GlowingEyesScaled.PawnRenderNodeWorker_EyeGlow</workerClass>
        <tagDef>GES_EyeGlowRight</tagDef>
        <parentTagDef>Head</parentTagDef>
        <texPath>Things/Mote/EyeGlow</texPath>
        <shaderTypeDef>MoteGlow</shaderTypeDef>
        <anchorTag>RightEye</anchorTag>
        <side>Right</side>
        <drawSize>0.2</drawSize>
        <rotDrawMode>Fresh, Rotting</rotDrawMode>
        <visibleFacing>
          <li>East</li>
          <li>South</li>
          <li>West</li>
        </visibleFacing>
        <drawData>
          <defaultData>
            <layer>72</layer>
            <offset>(0, 0, -0.25)</offset>
          </defaultData>
        </drawData>
      </li>

      <li>
        <nodeClass>GlowingEyesScaled.PawnRenderNode_EyeGlow</nodeClass>
        <workerClass>GlowingEyesScaled.PawnRenderNodeWorker_EyeGlow</workerClass>
        <tagDef>GES_EyeGlowLeft</tagDef>
        <parentTagDef>Head</parentTagDef>
        <texPath>Things/Mote/EyeGlow</texPath>
        <shaderTypeDef>MoteGlow</shaderTypeDef>
        <anchorTag>LeftEye</anchorTag>
        <side>Left</side>
        <drawSize>0.2</drawSize>
        <rotDrawMode>Fresh, Rotting</rotDrawMode>
        <visibleFacing>
          <li>East</li>
          <li>South</li>
          <li>West</li>
        </visibleFacing>
        <drawData>
          <defaultData>
            <layer>72</layer>
            <offset>(0, 0, -0.25)</offset>
            <flip>true</flip>
          </defaultData>
          <dataWest>
            <flip>false</flip>
          </dataWest>
        </drawData>
      </li>

    </nodes>
  </GlowingEyesScaled.EyeGlowDef>

</Defs>
